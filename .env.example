# ==============================================================================
# HUNGYEN.TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường VPS của bạn.
# ==============================================================================

# Cấu hình Server (VPS Port 3031)
PORT=3031
NODE_ENV=production
SITE_URL=https://hungyen.today
DEMO_SITE_URL=https://hungyen.today
JWT_SECRET=hungyen_today_super_secret_jwt_key_2026_please_change

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=HungYen.today Platform
BRAND_NAME=HungYen.today
BRAND_SHORT_NAME=Hưng Yên Today
AI_AGENT_NAME=Hưng Yên AI Assistant
SUPPORT_EMAIL=contact@hungyen.today

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hungyen_today_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Vé sự kiện, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Biên Tập HungYen.today
SMTP_FROM="HungYen.today" <contact@hungyen.today>
